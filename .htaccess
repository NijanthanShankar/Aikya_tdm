Options -MultiViews
RewriteEngine On

# Serve API PHP files directly — no rewriting
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ - [L]

# SPA fallback — all other routes → index.html (React Router)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
